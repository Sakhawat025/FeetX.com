generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Role {
  ADMIN
  RIDER
  CUSTOMER
}


enum DeliveryStatus {
  PENDING
  CONFIRMED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}


model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(CUSTOMER)
  status    Boolean  @default(true)
  isAvailable Boolean @default(true)
  vehicleName String?
  plateNumber String?
  vehicleId   String?
  zone        String?

  // Customer deliveries
  customerDeliveries Delivery[] @relation("CustomerDeliveries")

  // Rider assigned deliveries
  riderDeliveries Delivery[] @relation("RiderDeliveries")

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riderLocation RiderLocation?

  assignedVehicle Vehicle?
}


model Delivery {

  id Int @id @default(autoincrement())

  trackingId String @unique

  senderName String
  receiverName String
  receiverPhone String?

  pickupAddress String
  deliveryAddress String
  pickupLatitude    Float?
  pickupLongitude   Float?
  deliveryLatitude  Float?
  deliveryLongitude Float?

  parcelType String
  parcelWeight Float?
  assignedAt  DateTime?
  dueAt       DateTime?
  deliveredAt DateTime?

  rating      Int?
  feedback    String?
  reviewedAt  DateTime?

  status DeliveryStatus @default(PENDING)


  customerId Int
  customer User @relation("CustomerDeliveries", fields: [customerId], references: [id])


  riderId Int?
  rider User? @relation("RiderDeliveries", fields: [riderId], references: [id])


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priority ParcelPriority?

}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model RiderLocation {
  riderId    Int      @id
  rider      User     @relation(fields: [riderId], references: [id], onDelete: Cascade)

  sessionId  String?
  latitude   Float?
  longitude  Float?
  accuracy   Float?
  capturedAt DateTime?
  updatedAt  DateTime @updatedAt
}

enum VehicleStatus {
  ACTIVE
  IDLE
  MAINTENANCE
}

model Vehicle {
  id             Int           @id @default(autoincrement())
  name           String
  plateNumber    String        @unique
  type           String
  capacityKg     Float
  fuelPercent    Int?
  lastServicedAt DateTime?      @db.Date
  status         VehicleStatus @default(IDLE)

  riderId        Int?          @unique
  rider          User?         @relation(fields: [riderId], references: [id], onDelete: SetNull)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model PlatformSettings {
  id                        Int      @id @default(1)
  maxActiveParcels           Int      @default(4)
  autoAssignmentRadiusKm    Float    @default(5)
  priorityDeliveryBufferMin Int      @default(15)

  companyName   String @default("FleetX Logistics")
  supportEmail  String @default("")
  operatingCity String @default("Dhaka, Bangladesh")

  version   Int      @default(1)
  updatedBy Int?
  updatedAt DateTime @updatedAt
}

enum ParcelPriority {
  STANDARD
  EXPRESS
}